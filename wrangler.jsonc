{
	// cloudflare runs npm run build, then publishes whatever the build left in public. requests for
	// anything that isn't a file there, which is only the signup form, go to worker.js
	"name": "test-repo5",
	"main": "worker.js",
	"compatibility_date": "2026-09-01",
	"assets": {"directory": "public"},
	// keeps the worker's logs in the dashboard, so a failed notification shows up there
	"observability": {"enabled": true},

	// where signups are kept. make the database in the dashboard first, then paste its id here
	"d1_databases": [
		{"binding": "SIGNUPS", "database_name": "test-repo5-signups", "database_id": "e20dfc37-2d7b-47ec-9efc-9bb81be2c913"}
	],

	// email notifications go through resend. the key is a secret, kept in the dashboard rather than
	// here: settings > variables and secrets > add, type secret, named RESEND_API_KEY. the to address
	// has to be the one the resend account was made with
	"vars": {"NOTIFY_TO": "gabrieldrozdov@gmail.com"}
}
